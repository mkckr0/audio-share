### Component 9: Server Discovery (UDP Broadcast)

#### [MODIFY] `server-core/src/network_manager.cpp`

Add periodic UDP broadcast on port 59200 (matching AudioRelay convention):

```cpp
asio::awaitable<void> NetworkManager::discovery_beacon_loop() {
    auto endpoint = udp::endpoint(
        asio::ip::address_v4::broadcast(), 59200);
    
    DiscoveryBeacon beacon;
    beacon.set_app_name("AudioStream");
    beacon.set_server_name(hostname_);
    beacon.set_port(port_);
    beacon.set_version(APP_VERSION);
    beacon.set_supports_opus(true);
    beacon.set_supports_mic(true);
    
    while (running_) {
        auto data = beacon.SerializeAsString();
        co_await udp_socket_.async_send_to(
            asio::buffer(data), endpoint, asio::use_awaitable);
        co_await asio::steady_timer(io_, 2s).async_wait(asio::use_awaitable);
    }
}
```

