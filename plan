#### [NEW] `android-app/.../service/MicCaptureService.kt`

```kotlin
class MicCaptureService : Service() {
    private var audioRecord: AudioRecord? = null
    private var opusEncoder: OpusEncoder? = null  // Native JNI binding
    private var isCapturing = false
    
    // Called when PC requests mic start via TCP control command
    fun startCapture(config: StreamConfig, udpTarget: InetSocketAddress) {
        val source = when(config.micSource) {
            MicSource.DEFAULT -> MediaRecorder.AudioSource.DEFAULT
            MicSource.VOICE_COMM -> MediaRecorder.AudioSource.VOICE_COMMUNICATION
            MicSource.RAW -> MediaRecorder.AudioSource.UNPROCESSED
        }
        
        audioRecord = AudioRecord.Builder()
            .setAudioSource(source)
            .setAudioFormat(AudioFormat.Builder()
                .setSampleRate(config.sampleRate)
                .setChannelMask(AudioFormat.CHANNEL_IN_MONO)
                .setEncoding(AudioFormat.ENCODING_PCM_FLOAT)
                .build())
            .setBufferSizeInBytes(minBufferSize)
            .build()
        
        // Capture loop in coroutine — encode with Opus and send via UDP
        captureJob = scope.launch(Dispatchers.IO) { captureLoop(udpTarget) }
    }
    
    fun stopCapture() {
        isCapturing = false
        audioRecord?.stop()
        audioRecord?.release()
    }
}
```

